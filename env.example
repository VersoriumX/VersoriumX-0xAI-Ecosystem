# Pinata IPFS API Keys
PINATA_API_KEY="YOUR_PINATA_API_KEY"
PINATA_SECRET_API_KEY="YOUR_PINATA_SECRET_API_KEY"

# Ethereum Node Provider (Alchemy/Infura)
ALCHEMY_API_KEY="YOUR_ALCHEMY_API_KEY"
INFURA_API_KEY="YOUR_INFURA_API_KEY" # Use either Alchemy or Infura

# Wallet Private Key for deployments (NEVER use your main wallet's private key!)
# For local dev/testnets, you can use a fresh key or a Hardhat default.
# Ensure it's prefixed with 0x
DEPLOYER_PRIVATE_KEY="0xYOUR_DEPLOYER_PRIVATE_KEY_FOR_DEVELOPMENT_ONLY"

# AI Backend API Key (for frontend to authenticate with AI backend)
AI_BACKEND_API_KEY="YOUR_AI_BACKEND_API_KEY"

# WalletConnect Cloud Project ID (for frontend)
VITE_WALLET_CONNECT_PROJECT_ID="YOUR_WALLET_CONNECT_PROJECT_ID"

# Frontend API URL for AI Backend (development)
VITE_AI_BACKEND_API_URL="http://localhost:8000/ai"

# Project-wide details
VERSORIUMX_PROJECT_NAME="VersoriumX-0xAI-Ecosystem"
VERSORIUMX_PROJECT_VERSION="0.1.0"
