{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs", // Hardhat scripts typically run in Node.js commonjs environment
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist", // Where compiled JS files go
    "resolveJsonModule": true,
    "composite": true // Needed for project references
  },
  "include": [
    "./hardhat.config.ts",
    "./scripts/**/*.ts",
    "./test/**/*.ts"
  ],
  "files": [
    "./hardhat.config.ts" // explicitly include config
  ]
}
